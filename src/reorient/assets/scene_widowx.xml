<mujoco model="reorient scene widowx">
  <!-- WidowX 250 S is attached in Python (envs/model.py) onto the table, 0.4 m behind the object. -->
  <option timestep="0.0005" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="130" elevation="-25" offwidth="1280" offheight="960"/>
  </visual>

  <default>
    <default class="cupgeom">
      <geom material="cup" density="1100" condim="4" friction="1.0 0.01 0.001"/>
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="grid" builtin="checker" mark="edge" rgb1="0.25 0.3 0.35" rgb2="0.2 0.25 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="grid" texture="grid" texuniform="true" texrepeat="5 5" reflectance="0.1"/>
    <material name="table" rgba="0.55 0.45 0.35 1"/>
    <material name="cup" rgba="0.85 0.25 0.2 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 2"/>
    <light pos="0.5 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="grid"/>
    <!-- Table top at z=0.72; the small arm is mounted on it. -->
    <geom name="table" type="box" size="0.45 0.45 0.36" pos="0.45 0 0.36" material="table" friction="1 0.005 0.0001"/>
    <include file="cup.xml"/>
  </worldbody>
</mujoco>
