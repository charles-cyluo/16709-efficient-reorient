<mujoco model="reorient scene">
  <include file="panda/panda.xml"/>

  <option timestep="0.0005" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="130" elevation="-25" offwidth="1280" offheight="960"/>
  </visual>

  <default>
    <default class="cupgeom">
      <geom material="cup" density="1100" condim="4" friction="1.0 0.01 0.001"/>
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="grid" builtin="checker" mark="edge" rgb1="0.25 0.3 0.35" rgb2="0.2 0.25 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="grid" texture="grid" texuniform="true" texrepeat="5 5" reflectance="0.1"/>
    <material name="table" rgba="0.55 0.45 0.35 1"/>
    <material name="cup" rgba="0.85 0.25 0.2 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 2"/>
    <light pos="0.5 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="grid"/>
    <!-- Robot stands on the floor at the origin; the table (top at z=0.72, like a real table) is in
         front of it. A horizontal-hand grasp is only reachable (joint-6 limit) at table-like heights. -->
    <geom name="table" type="box" size="0.25 0.45 0.36" pos="0.77 0 0.36" material="table" friction="1 0.005 0.0001"/>

    <!-- Cup: hollow open-top cup (generated by scripts/make_cup_xml.py), 9 cm tall,
         origin at its geometric center. Mass/friction are randomized by the env. -->
    <include file="cup.xml"/>
  </worldbody>

  <keyframe>
    <!-- side pre-grasp pose: hand horizontal pointing +x, fingers open along world y, TCP 8 cm in
         front of the cup (solved offline with reorient.policies.cartesian.solve_ik) -->
    <key name="ready" qpos="0.0078 -0.5090 -0.0373 -2.2172 -0.1788 3.2811 -2.1973  0.04 0.04  0.6 0 0.765 1 0 0 0"
         ctrl="0.0078 -0.5090 -0.0373 -2.2172 -0.1788 3.2811 -2.1973 255"/>
  </keyframe>
</mujoco>
